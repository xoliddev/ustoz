# Ustoz API configuration. Copy to .env and fill in. Placeholders only — never commit real values.
NODE_ENV=production
PORT=4182

# Postgres (the role must own the schema; it runs the migrations). docker-compose sets this for you.
DATABASE_URL=postgres://ustoz:ustoz@localhost:5432/ustoz

# Public URLs: this API, and where the web app / Mini App is hosted (certificate QR links point there).
PUBLIC_URL=https://api.example.com
MINIAPP_URL=https://app.example.com
# Comma-separated origins allowed by CORS (the web app origin).
CORS_ORIGINS=https://app.example.com
CENTRE_NAME=Your Learning Centre
# Set to true behind a reverse proxy so per-IP rate limits see the real client IP.
TRUST_PROXY=false

# Telegram bot from @BotFather. Leave empty to run without the bot and Telegram login.
BOT_TOKEN=
# Secret for X-Telegram-Bot-Api-Secret-Token on POST /hooks/telegram (16+ chars A-Z a-z 0-9 _ -).
BOT_WEBHOOK_SECRET=
# How old Telegram initData may be when signing in (seconds).
INITDATA_MAX_AGE_SEC=3600

# HS256 secret for access tokens (32+ chars). Generate: openssl rand -hex 32
JWT_SECRET=<replace-with-output-of-openssl-rand-hex-32>
# HMAC key that signs certificates (32+ chars). Generate: openssl rand -hex 32
CERT_SECRET=<replace-with-output-of-openssl-rand-hex-32>

# Payments run in sandbox only (any other value is refused). Fill in your providers' TEST credentials.
PAYMENTS_MODE=sandbox
PAYME_MERCHANT_ID=
PAYME_TEST_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_SERVICE_ID=
UZUM_LOGIN=
UZUM_PASSWORD=

# Optional AI test generation (off when empty; the deterministic local generator is used instead).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
